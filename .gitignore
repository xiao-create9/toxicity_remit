.DS_Store
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
__pycache__/
*.py[cod]
*.egg-info/

# Data and experiment artifacts are generated locally.
data/raw/*
data/interim/*
data/processed/*
data/splits/*
runs/*
reports/*
scheduler_logs/

# Keep directory contracts in Git.
!data/raw/.gitkeep
!data/raw/SOURCE.md
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/splits/.gitkeep
!data/splits/tox21/
!data/splits/tox21/scaffold/
!data/splits/tox21/scaffold/split_*.csv
!data/splits/tox21/scaffold/split_*.json
!runs/.gitkeep
!reports/.gitkeep
